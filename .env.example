# ==============================================================================
# JARVIS — Environment Configuration Template (.env.example)
# DO NOT put real credentials or sensitive API keys in this file.
# Copy this file to .env for local development.
# ==============================================================================

# Environment mode: development | testing | production
JARVIS_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO

# Application Data Directory (Leave empty for default OS user data path)
# Default on Windows: %LOCALAPPDATA%\JARVIS
JARVIS_DATA_DIR=

# Database URL (SQLite)
# Default: sqlite:///%LOCALAPPDATA%/JARVIS/jarvis.db (in dev: sqlite:///./jarvis.db)
JARVIS_DATABASE_URL=

# Backend Binding (Development loopback only)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# AI Provider Selection (empty = mock/offline adapter)
# Supported options: mock | ollama | openai | anthropic
JARVIS_AI_PROVIDER=mock

# Local Model Integration (Ollama)
JARVIS_LOCAL_MODEL_ENABLED=false
JARVIS_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
JARVIS_LOCAL_MODEL_NAME=llama3.2:latest

# Cloud AI Provider Credentials (Optional — only when enabled)
# Never commit real API keys to version control.
JARVIS_OPENAI_API_KEY=
JARVIS_ANTHROPIC_API_KEY=
JARVIS_GOOGLE_API_KEY=
JARVIS_OPENROUTER_API_KEY=

# Diagnostics & Telemetry
JARVIS_ENABLE_DIAGNOSTICS=true
