# JARVIS Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit actual secrets, keys, or tokens to version control.

# Application Core
JARVIS_ENV=development
JARVIS_PORT=8000
JARVIS_HOST=127.0.0.1
JARVIS_DEBUG=true
JARVIS_LOG_LEVEL=INFO

# Local Persistence
JARVIS_DATA_DIR=./data
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_MODELS_DIR=./models
JARVIS_BACKUP_DIR=./backups

# Security & Encryption
# Cryptographic salt and key reference for local database and sensitive field encryption
JARVIS_SECRET_SALT=CHANGE_THIS_LOCAL_SALT_VALUE_AT_FIRST_RUN

# Mode Controls (Local/Offline Mode Enforced vs Online Hybrid)
JARVIS_OFFLINE_MODE=true
JARVIS_ALLOW_CLOUD_FALLBACK=false

# Cloud AI Provider Placeholders (Optional - used ONLY in Online/Hybrid mode when authorized)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Voice Configuration
JARVIS_SPEECH_ENGINE=offline
JARVIS_TTS_VOICE=en-US-Neural
JARVIS_WAKE_WORD=Jarvis
JARVIS_WAKE_WORD_SENSITIVITY=0.5
